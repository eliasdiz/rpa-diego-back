{
  "name": "rpa-diego-back",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node --watch ./bin/server",
    "build": "echo 'No build step required'",
    "test-stagehand": "npx tsx services/stagehand-test.ts",
    "dev-stagehand": "npx tsx --watch services/stagehand-test.ts",
    "stagehand-simple": "npx tsx services/stagehand-simple.ts",
    "stagehand-hibrida": "npx tsx services/stagehand-hibrida.ts",
    "stagehand-connect": "npx tsx services/stagehand-connect.ts",
    "chrome": "bash scripts/abrir-chrome-debug.sh",
    "salesforce-stagehand": "npx tsx --import dotenv/config services/automatizacion-salesforce-stagehand.ts",
    "salesforce-puppeteer": "npx tsx services/automatizacion-salesforce-puppeteer.ts",
    "salesforce-refactorizada": "node scripts/run-automatizacion.js",
    "test-salesforce": "npx tsx services/test-salesforce-stagehand.ts"
  },
  "type": "module",
  "dependencies": {
    "@browserbasehq/stagehand": "^2.5.2",
    "@formkit/tempo": "^0.1.2",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "dotenv": "^16.6.1",
    "express": "~4.16.1",
    "http-errors": "~1.6.3",
    "jade": "~1.11.0",
    "morgan": "~1.9.1",
    "playwright": "^1.56.1",
    "puppeteer": "^24.10.2",
    "puppeteer-core": "^24.16.1",
    "socket.io": "^4.8.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
